# Required — get it from @BotFather
TELEGRAM_BOT_TOKEN=your_token_here

# Default group for brand-new subscribers; everyone can change it in the bot
GROUP_ID=26R-22302-PLK-1

# Interface language before the user picks one: ru / en / lv
DEFAULT_LANGUAGE=ru

# The university's timezone, NOT the server's. A container on UTC would
# otherwise send the 07:00 digest at 10:00 Riga time.
TIMEZONE=Europe/Riga

# Monday of week 1. Odd/even subgroup rules are counted from this date.
SEMESTER_START=2026-08-31

MORNING_NOTIFY_TIME=07:00       # when the morning digest goes out
REMINDER_MINUTES_BEFORE=15      # how long before a class to remind
CHECK_INTERVAL_MINUTES=20       # how often to poll for cancellations

# Where the SQLite database lives. docker compose overrides this with
# /data/bot.db so the database survives redeploys — leave it alone there.
DB_PATH=bot.db
